@import url('https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css');
/* ai-china.xyz patch v2: fusion layout.
   TaoTao rhythm (a little every day) + Japanese-tutor minimal layout
   (warm paper, rust accent, generous white space, one quiet button).
   These classes are only used by the new landing / lesson pages,
   so they do not restyle old blog posts. */

.fused-hero {
  text-align: center;
  padding: 2.2rem 0 1.2rem;
}

.fused-kicker {
  font-size: 0.72rem;
  letter-spacing: 0.22em;
  color: #b3612e;
  font-weight: 700;
}

.fused-hero h1 {
  font-size: 2.1rem;
  line-height: 1.25;
  margin: 1rem 0 0.8rem;
}

.fused-photo {
  margin: 1.6rem 0 1.2rem;
  padding: 2.2rem 1rem;
  border-radius: 12px;
  background: linear-gradient(135deg, #c47a3e, #a85f2b 55%, #7a4a28);
  color: #fff8ec;
  font-size: 4rem;
  line-height: 1.1;
}

.fused-photo span {
  display: block;
  font-size: 0.78rem;
  letter-spacing: 0.04em;
  margin-top: 0.6rem;
}

.fused-hero a,
.fused-card a {
  display: inline-block;
  border: 1.5px solid #2b2118;
  border-radius: 999px;
  padding: 0.65rem 1.4rem;
  color: #2b2118;
  text-decoration: none;
  font-size: 0.9rem;
}

.fused-card {
  border: 1px solid #e5e0d8;
  border-radius: 12px;
  padding: 1.2rem 1.3rem;
  background: #fffdf9;
  margin: 1rem 0 1.5rem;
}

.fused-card h3 {
  margin-top: 0;
}

@media (max-width: 768px) {
  .fused-hero h1 {
    font-size: 1.7rem;
  }
  .fused-photo {
    font-size: 3rem;
  }
}

/* v2.4: video / audio slots. Used by the homepage, Tai Chi and news pages.
   Placeholder boxes are visible until Allen drops a real file in and swaps
   the placeholder div for the <video>/<audio> snippet in README-PATCH-v2.4. */
.fused-media {
  margin: 1rem 0 0.2rem;
}
.fused-media video,
.fused-media audio {
  width: 100%;
  display: block;
  border-radius: 10px;
  background: #f3ede2;
  border: 1px solid #e5e0d8;
}
.fused-media audio {
  margin-top: 0.6rem;
}
.fused-media figcaption {
  font-size: 0.82rem;
  color: #6b5d4f;
  margin-top: 0.4rem;
}
.fused-media-placeholder {
  border: 1.5px dashed #b3612e;
  border-radius: 10px;
  background: #fdf6ec;
  color: #6b4a2f;
  text-align: center;
  padding: 1.1rem 0.8rem;
  font-size: 0.88rem;
  line-height: 1.6;
}
.fused-media-placeholder span {
  display: block;
  font-size: 0.78rem;
  color: #8a7a6a;
}
/* Breathing circle for Tai Chi: works with no media file at all.
   8 seconds per breath: inhale (grow) then exhale (shrink). */
.fused-breathe-wrap {
  text-align: center;
  margin: 1rem 0 0.2rem;
}
.fused-breathe {
  width: 96px;
  height: 96px;
  margin: 0 auto;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #e8b07a, #b3612e);
  animation: fused-breathe 8s ease-in-out infinite;
}
.fused-breathe-label {
  font-size: 0.82rem;
  color: #6b5d4f;
  margin-top: 0.5rem;
}
@keyframes fused-breathe {
  0%, 100% { transform: scale(0.82); opacity: 0.75; }
  50% { transform: scale(1.12); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .fused-breathe { animation: none; }
}

/* v2.5: WenKai headings + gentle CSS effects. Body text stays system sans
   for readability and speed; WenKai is used only for headings and the big
   Chinese characters, with serif fallbacks if the font has not loaded yet. */
.fused-hero h1,
.fused-card h2,
.fused-card h3,
#article-container h1,
#article-container h2,
#article-container h3 {
  font-family: "LXGW WenKai", "Noto Serif SC", "Songti SC", serif;
  letter-spacing: 0.02em;
}
.fused-card h3 {
  font-size: 1.45rem;
  line-height: 1.4;
}
.fused-tones {
  color: #b3612e;
  letter-spacing: 0.18em;
  font-weight: 700;
}
/* One-time entrance: hero fades up once on load, cards follow. */
@keyframes fused-fade-up {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.fused-hero {
  animation: fused-fade-up 0.7s ease-out both;
}
.fused-card {
  animation: fused-fade-up 0.7s ease-out both;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}
.fused-card:nth-of-type(2) { animation-delay: 0.12s; }
.fused-card:nth-of-type(3) { animation-delay: 0.24s; }
/* Cards lift gently on hover; buttons fill with rust on hover. */
.fused-card:hover {
  transform: translateY(-3px);
  border-color: #c9a37e;
  box-shadow: 0 10px 28px rgba(122, 74, 40, 0.13);
}
.fused-hero a,
.fused-card a {
  transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
}
.fused-hero a:hover,
.fused-card a:hover {
  background-color: #b3612e;
  color: #fff8ec;
  transform: translateY(-1px);
}
/* Media: soft shadow, and a little lift on hover for video/poster. */
.fused-media video {
  box-shadow: 0 8px 22px rgba(122, 74, 40, 0.12);
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}
.fused-media video:hover {
  box-shadow: 0 12px 30px rgba(122, 74, 40, 0.18);
}
.fused-photo {
  box-shadow: 0 10px 26px rgba(122, 74, 40, 0.18);
}
::selection {
  background: #f0d9bd;
  color: #2b2118;
}
@media (prefers-reduced-motion: reduce) {
  .fused-hero, .fused-card { animation: none; }
  .fused-card, .fused-hero a, .fused-card a, .fused-media video { transition: none; }
}
